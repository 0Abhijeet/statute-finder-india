# Copy to .env and fill in. Never commit .env.

# Dev database (local docker: see docker-compose.yml, host port 15433)
DATABASE_URL=postgresql://statute:statutepassword@localhost:15433/statutedb
# Tests run against this one (drop_all runs before/after each test: never point
# the test suite at a dev or hosted database)
# DATABASE_URL=postgresql://statute:statutepassword@localhost:15433/statutedb_test

# LLM (OpenAI-compatible endpoint; defaults point at Groq)
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# Embeddings: batch size bounds peak memory
# EMBED_BATCH_SIZE=8

# Langfuse: placeholders only; tracing not wired yet (deferred, see DECISIONS.md)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
